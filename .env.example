# Copy to .env.local and fill in from Supabase → Settings → API.
#
# Both of these are meant to be public: they ship inside the built JavaScript
# and anyone can read them out of the browser. What protects your data is the
# row-level security in supabase/schema.sql, not the secrecy of this key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# NOTE: your Anthropic key does NOT belong here. Anything with a VITE_ prefix is
# compiled into the frontend bundle and is readable by every visitor. It goes in
# Supabase → Edge Functions → Secrets, named ANTHROPIC_API_KEY, where only the
# server-side function can read it.
