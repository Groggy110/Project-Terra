# Copy to .env.local and fill in from Supabase → Settings → API.
#
# Both of these are meant to be public: they ship inside the built JavaScript
# and anyone can read them out of the browser. What protects your data is the
# row-level security in supabase/schema.sql, not the secrecy of this key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# NOTE: your Anthropic key does NOT belong here. Anything with a VITE_ prefix is
# compiled into the frontend bundle and is readable by every visitor. It goes in
# Supabase → Edge Functions → Secrets, named ANTHROPIC_API_KEY, where only the
# server-side function can read it.

# ---------------------------------------------------------------- map tiles
#
# Satellite imagery streamed in as you zoom past a region. Leave all of this
# unset and the globe uses Esri World Imagery, which needs no key — enough for
# a demonstration, and it works on a fresh clone. For anything with traffic,
# get your own key from one of the providers below.
#
#   esri      no key, no sign-up          (the default)
#   mapbox    pk.ey... from account.mapbox.com
#   maptiler  key from cloud.maptiler.com
#
# VITE_TILES_PROVIDER=mapbox
# VITE_TILES_KEY=pk.ey...
#
# Or any XYZ source you have the rights to. It must send
# Access-Control-Allow-Origin: tiles are composited into a canvas that is
# uploaded to WebGL, and a tainted canvas cannot be.
#
# VITE_TILES_URL=https://example.com/tiles/{z}/{x}/{y}.jpg?key={key}
# VITE_TILES_SIZE=512
# VITE_TILES_MAX_ZOOM=20
# VITE_TILES_ATTRIBUTION=Imagery: Example
#
# VITE_TILES_PROVIDER=none turns the layer off entirely.
#
# Google is deliberately not an option: Google Maps Platform forbids its
# content being shown "with or near a non-Google map", which is exactly what
# this globe is.
